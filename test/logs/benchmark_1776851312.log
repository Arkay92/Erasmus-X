def bubble_sort(data):
    n = len(data))
    for i in range(n):
        for j in range(n - i - 1):
            if data[j] > data[j + 1]:
                data[j], data[j + 1] = data[j + 1], data[j]
    return data

if __name__ == '__main__':
    numbers = [34, 12, 2, 5, 8]
    print(bubble_sort(numbers))

