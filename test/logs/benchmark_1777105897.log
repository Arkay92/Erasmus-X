/*
 * Global styles for the Todo List application.
 * This file sets up the base styling for the entire application.
 */

body {
  font-family: 'Arial', sans-serif;
  background-color: #f0f2f5;
  min-height: 100vh;
  margin: 0;
}

#main-container {
  max-width: 800px;
  margin: 40px auto;
  padding: 20px;
  background-color: white;
  box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
  min-height: 80vh;
}

.todo-item {
  padding: 15px;
  margin-bottom: 10px;
  border-bottom: 1px solid #eee;
  background-color: #f9f9f9;
  transition: background-color 0.3s;
}

.todo-item:hover {
  background-color: #f0f2f5;
}

.task-completed {
  text-decoration: line-through;
  color: #888;
}
